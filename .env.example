# ResumePilot — 로컬 개발용
#   copy .env.example .env.local
#   각 터미널에서 . .\scripts\load-env-local.ps1
# 배포는 .env.production.example 사용

# ===== PostgreSQL (docker: pgvector/pgvector:pg17) =====
POSTGRES_DB=resumepilot
POSTGRES_USER=resumepilot
POSTGRES_PASSWORD=resumepilot
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/resumepilot
SPRING_DATASOURCE_USERNAME=resumepilot
SPRING_DATASOURCE_PASSWORD=resumepilot
DATABASE_URL=postgresql://resumepilot:resumepilot@localhost:5432/resumepilot?sslmode=disable

# ===== Spring API =====
JWT_SECRET=change-me-at-least-256-bits-long-secret-key-for-local-dev
# Notion OAuth 콜백 (Notion 앱 Redirect URI 와 동일해야 함)
# PUBLIC_API_URL=http://localhost:8080
# PUBLIC_WEB_URL=http://localhost:5173
# Access 15분, Refresh 24시간(로그인 시각 기준, 갱신해도 연장하지 않음)
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=86400000
INTERNAL_API_TOKEN=change-me-internal-token
# Ops API (/api/v1/ops/**) — Grok 운영매니저 등. 헤더 X-Ops-Token
OPS_BOT_TOKEN=change-me-ops-bot-token
LLM_ENCRYPTION_KEY=change-me-32-byte-or-longer-secret

# ===== 관리자 계정 (기동 시 생성) =====
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

# ===== LLM — 자소서 생성은 외부 AI API 호출 =====
# 모델·키는 Admin /admin/llm-settings (DeepSeek, Gemini 등).
# 서버에 LLM 가중치를 올리지 않습니다. Hugging Face 로컬 호스팅 아님.
# 아래 OPENAI_* 는 OpenAI SDK 호환 폴백 전용 — 운영에서는 비워 두세요.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# EMBEDDING_MODEL=text-embedding-3-small

# ===== 자격증 종목 조회 (선택) — 공공데이터포털 Q-Net 국가자격 종목 목록 =====
# https://www.data.go.kr/data/15003024/openapi.do
# QNET_LOOKUP_ENABLED=true
# QNET_SERVICE_KEY=

# ===== 공개 웹(빌드 시, 선택) =====
# VITE_GOOGLE_SITE_VERIFICATION=
# VITE_NAVER_SITE_VERIFICATION=
# VITE_ADSENSE_CLIENT=
# VITE_CONTACT_EMAIL=

# ===== Deploy (Git 커밋 금지) =====
# DEPLOY_HOST=user@your-lan-host
# LAN_HOST=your-lan-host
# APP_PORT=9180
